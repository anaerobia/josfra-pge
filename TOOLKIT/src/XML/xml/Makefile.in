@am__fastdepCC_TRUE@	then mv -f "$(DEPDIR)/libxmlxml_la-SAX.Tpo" "$(DEPDIR)/libxmlxml_la-SAX.Plo"; else rm -f "$(DEPDIR)/libxmlxml_la-SAX.Tpo"; exit 1; fi
@AMDEP_TRUE@@am__fastdepCC_FALSE@	source='SAX.c' object='libxmlxml_la-SAX.lo' libtool=yes @AMDEPBACKSLASH@
