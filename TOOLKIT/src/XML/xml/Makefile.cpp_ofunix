	$(CC) -c $(CFLAG1) $(OPT_LEVEL) $(DFLAGS) $(IFLAG) $? -o $@
$(PGSCPPO)/$(GRP)/SAX2.o: SAX2.c
	$(CC) -c $(CFLAG1) $(OPT_LEVEL) $(DFLAGS) $(IFLAG) $? -o $@
$(PGSCPPO)/$(GRP)/xmlwriter.o: xmlwriter.c
