$(PGSCPPO)/$(GRP)/pattern.o: pattern.c
	$(CC) -c $(CFLAG1) $(OPT_LEVEL) $(DFLAGS) $(IFLAG) $? -o $@
$(PGSCPPO)/$(GRP)/xmlsave.o: xmlsave.c
