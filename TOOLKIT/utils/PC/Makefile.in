PGS_PC_GetNumberOfFilesCom$(EXEEXT): $(PGS_PC_GetNumberOfFilesCom_OBJECTS) $(PGS_PC_GetNumberOfFilesCom_DEPENDENCIES) 
	@rm -f PGS_PC_GetNumberOfFilesCom$(EXEEXT)
	$(LINK) $(PGS_PC_GetNumberOfFilesCom_LDFLAGS) $(PGS_PC_GetNumberOfFilesCom_OBJECTS) $(PGS_PC_GetNumberOfFilesCom_LDADD) $(LIBS)
PGS_PC_GetReferenceCom$(EXEEXT): $(PGS_PC_GetReferenceCom_OBJECTS) $(PGS_PC_GetReferenceCom_DEPENDENCIES) 
	@rm -f PGS_PC_GetReferenceCom$(EXEEXT)
	$(LINK) $(PGS_PC_GetReferenceCom_LDFLAGS) $(PGS_PC_GetReferenceCom_OBJECTS) $(PGS_PC_GetReferenceCom_LDADD) $(LIBS)
PGS_PC_GetTempReferenceCom$(EXEEXT): $(PGS_PC_GetTempReferenceCom_OBJECTS) $(PGS_PC_GetTempReferenceCom_DEPENDENCIES) 
	@rm -f PGS_PC_GetTempReferenceCom$(EXEEXT)
	$(LINK) $(PGS_PC_GetTempReferenceCom_LDFLAGS) $(PGS_PC_GetTempReferenceCom_OBJECTS) $(PGS_PC_GetTempReferenceCom_LDADD) $(LIBS)
PGS_PC_InitCom$(EXEEXT): $(PGS_PC_InitCom_OBJECTS) $(PGS_PC_InitCom_DEPENDENCIES) 
	@rm -f PGS_PC_InitCom$(EXEEXT)
	$(LINK) $(PGS_PC_InitCom_LDFLAGS) $(PGS_PC_InitCom_OBJECTS) $(PGS_PC_InitCom_LDADD) $(LIBS)
PGS_PC_TempDeleteCom$(EXEEXT): $(PGS_PC_TempDeleteCom_OBJECTS) $(PGS_PC_TempDeleteCom_DEPENDENCIES) 
	@rm -f PGS_PC_TempDeleteCom$(EXEEXT)
	$(LINK) $(PGS_PC_TempDeleteCom_LDFLAGS) $(PGS_PC_TempDeleteCom_OBJECTS) $(PGS_PC_TempDeleteCom_LDADD) $(LIBS)
PGS_PC_TermCom$(EXEEXT): $(PGS_PC_TermCom_OBJECTS) $(PGS_PC_TermCom_DEPENDENCIES) 
	@rm -f PGS_PC_TermCom$(EXEEXT)
	$(LINK) $(PGS_PC_TermCom_LDFLAGS) $(PGS_PC_TermCom_OBJECTS) $(PGS_PC_TermCom_LDADD) $(LIBS)
pctcheck$(EXEEXT): $(pctcheck_OBJECTS) $(pctcheck_DEPENDENCIES) 
	@rm -f pctcheck$(EXEEXT)
	$(LINK) $(pctcheck_LDFLAGS) $(pctcheck_OBJECTS) $(pctcheck_LDADD) $(LIBS)
install-archbinSCRIPTS: $(archbin_SCRIPTS)
	@$(NORMAL_INSTALL)
	test -z "$(archbindir)" || $(mkdir_p) "$(DESTDIR)$(archbindir)"
	@list='$(archbin_SCRIPTS)'; for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  if test -f $$d$$p; then \
	    f=`echo "$$p" | sed 's|^.*/||;$(transform)'`; \
	    echo " $(archbinSCRIPT_INSTALL) '$$d$$p' '$(DESTDIR)$(archbindir)/$$f'"; \
	    $(archbinSCRIPT_INSTALL) "$$d$$p" "$(DESTDIR)$(archbindir)/$$f"; \
	  else :; fi; \
	done

uninstall-archbinSCRIPTS:
	@$(NORMAL_UNINSTALL)
	@list='$(archbin_SCRIPTS)'; for p in $$list; do \
	  f=`echo "$$p" | sed 's|^.*/||;$(transform)'`; \
	  echo " rm -f '$(DESTDIR)$(archbindir)/$$f'"; \
	  rm -f "$(DESTDIR)$(archbindir)/$$f"; \
	done

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/PGS_PC_Check.Po@am__quote@
@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/PGS_PC_GetConfigDataCom.Po@am__quote@
@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/PGS_PC_GetFileAttrCom.Po@am__quote@
