buildsmf:
	@echo "Building the smfcompile utility ..."
	@cd $(PGSSRC)/SMF; $(MAKE) $(MFLAGS) smfcompile

checkout:
	@if [ "$(CLEARCASE_ROOT)" != "" ] ; then			    \
		cleartool co -nc PGS_[1-9] PGS_[1-9][0-9];		    \
		cleartool co -nc $(top_srcdir)/include/PGS_[A-Z][A-Z]_[0-9]*.[hf];	    \
		cleartool co -nc $(top_srcdir)/include/PGS_[A-Z][A-Z][A-Z]_[0-9]*.[hf]; \
	fi
# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
