	$(SC) -f $? $(SF77FLAGS)

PGS_9: PGS_PC_9.t
	$(SC) -f $? $(SCFLAGS)
	$(SC) -f $? $(SF77FLAGS)

PGS_10: PGS_AA_10.t
	$(SC) -f $? $(SCFLAGS)
	$(SC) -f $? $(SF77FLAGS)

PGS_11: PGS_CUC_11.t
